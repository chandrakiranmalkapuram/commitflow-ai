# Environment variables for CommitFlow AI
# ---------------------------------------------------
# Application environment
NODE_ENV=development                     # one of: development, production, test
PORT=4000                               # server port

# Database & Redis
DATABASE_URL=postgresql://user:password@localhost:5432/commitflow?schema=public  # PostgreSQL connection URL
REDIS_URL=redis://localhost:6379       # Redis connection URL

# JWT secrets (min 32 chars in production)
JWT_SECRET=fallback_secret_do_not_use_in_prod_min_32_chars   # secret for access tokens
JWT_REFRESH_SECRET=fallback_refresh_secret_do_not_use_in_prod_32   # secret for refresh tokens
JWT_ACCESS_TTL=15m                     # access token TTL (e.g., 15m)
JWT_REFRESH_TTL=7d                     # refresh token TTL (e.g., 7d)

# GitHub integration
GITHUB_WEBHOOK_SECRET=default_webhook_secret_for_local_dev   # webhook secret for verifying GitHub payloads
GITHUB_CLIENT_ID=                      # GitHub OAuth client ID (optional)
GITHUB_CLIENT_SECRET=                  # GitHub OAuth client secret (optional)

# Encryption / BYOK (planned)
# ENCRYPTION_KEY=development_encryption_key_32bytes_min!   # symmetric key for data encryption (dev placeholder) (planned)
TOKEN_ENCRYPTION_KEY=                   # token encryption key (64 hex chars) (optional)

# LLM / AI provider configuration (planned)
# OPENAI_API_KEY=                        # API key for OpenAI provider (optional)
# LLM_PROVIDER=grok                      # default language model provider (planned)
# GROK_API_KEY=                          # API key for Grok provider (optional)

# Image generation provider (planned)
# IMAGE_PROVIDER=mock                    # image generation provider (planned)

# Frontend URL (CORS origin) (planned)
# FRONTEND_URL=http://localhost:5173    # URL of the frontend application (planned)
CORS_ORIGINS=http://localhost:5173     # allowed origins for CORS

# LinkedIn integration (planned)
# LINKEDIN_CLIENT_ID=                    # LinkedIn OAuth client ID (planned)
# LINKEDIN_CLIENT_SECRET=                # LinkedIn OAuth client secret (planned)
# LINKEDIN_REDIRECT_URI=                 # OAuth redirect URI for LinkedIn (planned)
# LINKEDIN_ACCESS_TOKEN=                 # Access token for LinkedIn API (planned)

# API URL for internal services (planned)
# COMMITFLOW_API_URL=http://localhost:4000   # base URL for CommitFlow API (planned)

# Worker configuration
WORKER_CONCURRENCY=3                  # number of concurrent workers
WORKER_RATE_MAX=10                    # max jobs per second per worker

# Rate limits
FREE_POST_LIMIT=3                     # free tier daily post limit
PRO_MONTHLY_LIMIT=100                  # pro tier monthly post limit

# Additional optional variables (placeholders, planned)
# R2 (Cloudflare) storage configuration
# R2_ACCOUNT_ID=                         # Cloudflare R2 account ID (planned)
# R2_ACCESS_KEY_ID=                      # R2 access key ID (planned)
# R2_SECRET_ACCESS_KEY=                  # R2 secret access key (planned)
# R2_BUCKET=                             # R2 bucket name (planned)
# R2_PUBLIC_URL=                         # Public URL for R2 bucket (planned)

# Stripe integration (planned)
# STRIPE_SECRET_KEY=                     # Stripe secret key (planned)
# STRIPE_WEBHOOK_SECRET=                # Stripe webhook secret (planned)
# STRIPE_PRO_PRICE_ID=                   # Stripe price ID for pro tier (planned)
